# Copy to .env (scripts/setup.sh does this and fills in AMI_SECRET).
# Shared secret between the web page and Asterisk's manager interface.
# Must match "secret=" in manager.conf.
AMI_SECRET=change-me
# Name of the child's phone in pjsip.conf and extensions.conf.
KID_ENDPOINT=kid
# Port of the admin page.
WEB_PORT=8099
# Owner of ./webui-data on the host (run: id -u ; id -g).
HOST_UID=1000
HOST_GID=1000
